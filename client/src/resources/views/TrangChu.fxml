<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.TrangChuController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <ImageView fitHeight="77.0" fitWidth="103.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
                <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: #F0F4FF; -fx-padding: 8 18; -fx-background-radius: 8; -fx-cursor: hand;" text="Trang chủ" textFill="#0A1128">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#switchToHistory" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Lịch sử" textFill="#0A1128">
                    <font><Font size="14.0" /></font>
                </Button>
            <Button mnemonicParsing="false" onAction="#switchToManager" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Quản lý sản phẩm">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
                <Button fx:id="btnPostItem" mnemonicParsing="false" onAction="#switchToPostItem" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Đăng sản phẩm" textFill="#0A1128">
                    <font><Font size="14.0" /></font>
                </Button>
            <Button fx:id="btnHistory1" mnemonicParsing="false" onAction="#switchToProfile" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Profile" textFill="#0A1128">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Hello User" textFill="#0A1128">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
            </children>
        </HBox>

        <VBox VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                    <children>
                        <Label text="Live Auctions" textFill="#0A1128">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" style="-fx-background-color: #EFEFEF; -fx-background-radius: 20; -fx-padding: 4;">
                            <children>
                                <Button mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 8 20; -fx-cursor: hand;" text="All" textFill="#0A1128">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="Ending Soon" textFill="#666666">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="New Arrivals" textFill="#666666">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="itemContainer" hgap="35.0" vgap="35.0">
                            <padding>
                                <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>

                                <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">
                                    <children>

                                        <StackPane prefHeight="240.0" style="-fx-background-color: #E8E8E8; -fx-background-radius: 20 20 0 0;">
                                            <children>
                                                <ImageView fitHeight="240.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />

                                                <Button mnemonicParsing="false" style="-fx-background-color: rgba(255,255,255,0.3); -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" text="🤍" textFill="WHITE" StackPane.alignment="TOP_RIGHT">
                                                    <StackPane.margin>
                                                        <Insets right="15.0" top="15.0" />
                                                    </StackPane.margin>
                                                    <font><Font size="14.0" /></font>
                                                </Button>

                                                <HBox spacing="8.0" StackPane.alignment="TOP_LEFT">
                                                    <StackPane.margin>
                                                        <Insets left="15.0" top="15.0" />
                                                    </StackPane.margin>
                                                </HBox>
                                            </children>
                                        </StackPane>

                                        <VBox spacing="15.0">
                                            <padding>
                                                <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
                                            </padding>
                                            <children>

                                                <Label prefHeight="55.0" text="Neo-Expressionist Study, 1982" textFill="#0A1128" wrapText="true">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>

                                                <HBox spacing="10.0">
                                                    <children>
                                                        <VBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="3.0" style="-fx-background-color: #F4F5F7; -fx-background-radius: 12; -fx-padding: 10 15;" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="CURRENT BID" textFill="#9DA3B4">
                                                                    <font><Font name="System Bold" size="10.0" /></font>
                                                                </Label>
                                                                <Label text="\$850,000" textFill="#0A1128">
                                                                    <font><Font name="System Bold" size="18.0" /></font>
                                                                </Label>
                                                            </children>
                                                        </VBox>

                                                        <VBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="3.0" style="-fx-background-color: #F4F5F7; -fx-background-radius: 12; -fx-padding: 10 15;" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="TIME LEFT" textFill="#9DA3B4">
                                                                    <font><Font name="System Bold" size="10.0" /></font>
                                                                </Label>
                                                                <Label text="12:04:11" textFill="#FF6B00">
                                                                    <font><Font name="System Bold" size="18.0" /></font>
                                                                </Label>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <Button maxWidth="Infinity" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #08103F; -fx-background-radius: 10; -fx-cursor: hand;" text="PLACE BID" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</VBox>
