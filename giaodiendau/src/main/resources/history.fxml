<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F0F8FF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.giaodiendau.ControllerHistory">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <ImageView fitHeight="59.0" fitWidth="129.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50;" text="Menu 🏠">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                <Button mnemonicParsing="false" style="-fx-background-color: #99BADD; -fx-text-fill: #2c3e50;" text="Lịch sử 📜">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToPostItem" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50;" text="Đăng sản phẩm 📤">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToProfile" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50;" text="Profile 👤">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="User?" />
                <ImageView fitHeight="58.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="lichsu" focusTraversable="true" spacing="15.0" style="-fx-background-color: #F0F8FF;">
                    <padding>
                        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
