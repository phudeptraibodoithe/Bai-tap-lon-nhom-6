            <AnchorPane layoutX="216.0" layoutY="7.0" prefHeight="586.0" prefWidth="376.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5); -fx-border-color: #DFB76C; -fx-background-insets: 2;">
