<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<VBox prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.ControllerProfile">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <ImageView fitHeight="59.0" fitWidth="129.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
                <Button mnemonicParsing="false" onAction="#switchToMenu" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Trang chủ">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToHistory" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Lịch sử ">
                    <font><Font size="14.0" /></font>
                </Button>
            <Button mnemonicParsing="false" onAction="#switchToManager" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Quản lý sản phẩm">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
                <Button mnemonicParsing="false" onAction="#switchToPostItem" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Đăng sản phẩm ">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" style="-fx-background-color: #F0F4FF; -fx-padding: 8 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Profile ">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #0A1128;" text="Hồ Sơ Của Tôi">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="30.0" />
                            </VBox.margin>
                        </Label>

                        <HBox spacing="40.0">
                            <children>
                                <VBox alignment="TOP_CENTER" prefWidth="350.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-padding: 35 25;">
                                    <children>
                                        <StackPane maxHeight="220.0" maxWidth="220.0" minHeight="220.0" minWidth="220.0" style="-fx-background-color: #F4F5F7; -fx-background-radius: 200; -fx-border-color: #e0e0e0; -fx-border-radius: 200; -fx-border-width: 2;">
                                            <children>
                                                <Label style="-fx-text-fill: #9DA3B4;" text="📷 Chạm để đổi" StackPane.alignment="BOTTOM_CENTER">
                                                    <font><Font size="12.0" /></font>
                                                    <StackPane.margin><Insets bottom="20.0" /></StackPane.margin>
                                                </Label>
                                                <ImageView fx:id="myImageView" fitHeight="220.0" fitWidth="220.0" onMouseClicked="#uploadImage" pickOnBounds="true" preserveRatio="true">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </ImageView>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="nickname" style="-fx-text-fill: #0A1128;" text="Tên tài khoản">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                        </Label>

                                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #F0F4FF; -fx-background-radius: 15; -fx-padding: 15; -fx-pref-width: 100%;">
                                            <children>
                                                <Label style="-fx-text-fill: #666666;" text="Số dư hiện tại">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Label>
                                                <Label fx:id="balance" style="-fx-text-fill: #4CAF50;" text="0 VNĐ">
                                                    <font><Font name="System Bold" size="24.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#switchToWallet" prefHeight="45.0"
                                                style="-fx-background-color: #F0F4FF; -fx-background-radius: 10; -fx-cursor: hand; -fx-text-fill: #2563EB; -fx-border-color: #2563EB; -fx-border-radius: 10; -fx-border-width: 1.5;"
                                                text="Quản lý ví TBOAT">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Button>

                                        <Region VBox.vgrow="ALWAYS" />

                                        <Button mnemonicParsing="false" onAction="#logout" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #E63946;" text="Đăng xuất ">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Button>
                                    </children>
                                </VBox>

                    <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20;
      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);
      -fx-padding: 35 30;" HBox.hgrow="ALWAYS">
                        <children>
                            <Label style="-fx-text-fill: #0A1128;" text="Thông tin cơ bản">
                                <font><Font name="System Bold" size="20.0" /></font>
                            </Label>

                            <!-- Nickname -->
                            <VBox spacing="8.0">
                                <Label style="-fx-text-fill: #666666;" text="Nickname">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="tfNickname"
                                           style="-fx-background-color: #F4F5F7; -fx-border-color: transparent;
                              -fx-background-radius: 10; -fx-padding: 12 15;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </VBox>

                            <!-- Email -->
                            <VBox spacing="8.0">
                                <Label style="-fx-text-fill: #666666;" text="Email">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="tfEmail" promptText="example@gmail.com"
                                           style="-fx-background-color: #F4F5F7; -fx-border-color: transparent;
                              -fx-background-radius: 10; -fx-padding: 12 15;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </VBox>

                            <!-- Số điện thoại -->
                            <VBox spacing="8.0">
                                <Label style="-fx-text-fill: #666666;" text="Số điện thoại">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="tfPhone" promptText="09xxxxxxxx"
                                           style="-fx-background-color: #F4F5F7; -fx-border-color: transparent;
                              -fx-background-radius: 10; -fx-padding: 12 15;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </VBox>

                            <!-- Mô tả -->
                            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                <Label style="-fx-text-fill: #666666;" text="Mô tả bản thân">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextArea fx:id="desc" prefHeight="120.0" promptText="Giới thiệu đôi nét về bạn..."
                                          wrapText="true" VBox.vgrow="ALWAYS"
                                          style="-fx-control-inner-background: #F4F5F7; -fx-background-radius: 10;
                             -fx-background-color: transparent; -fx-padding: 5;">
                                    <font><Font size="14.0" /></font>
                                </TextArea>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" />

                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                <Label fx:id="err" wrapText="true" HBox.hgrow="ALWAYS">
                                    <font><Font name="System" size="14.0" /></font>
                                </Label>

                                <Button fx:id="btnEdit" onAction="#onEdit" prefHeight="42.0" prefWidth="130.0"
                                        text="Chỉnh sửa"
                                        style="-fx-background-color: #0A1128; -fx-background-radius: 8; -fx-cursor: hand; -fx-text-fill: WHITE;">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button fx:id="btnCancel" onAction="#onCancelEdit" prefHeight="42.0" prefWidth="100.0"
                                        text="Hủy" visible="false"
                                        style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand; -fx-text-fill: #64748b;">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button fx:id="btnSave" onAction="#onSave" prefHeight="42.0" prefWidth="130.0"
                                        text="Lưu thay đổi" visible="false"
                                        style="-fx-background-color: #2563EB; -fx-background-radius: 8; -fx-cursor: hand; -fx-text-fill: WHITE; -fx-effect: dropshadow(three-pass-box, rgba(37,99,235,0.3), 10, 0, 0, 4);">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </HBox>
                        </children>
                    </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
