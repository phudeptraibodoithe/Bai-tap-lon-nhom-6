<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. KHAI BÁO CHA (PHẢI CÓ) -->
    <parent>
        <groupId>com.tboat</groupId>
        <artifactId>tboat-project</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath> <!-- Đường dẫn trỏ về file pom gốc -->
    </parent>

    <!-- 2. THÔNG TIN RIÊNG CỦA MODULE SERVER -->
    <artifactId>server</artifactId>
    <!-- Server thường build ra file jar, không để packaging pom -->

    <dependencies>
        <!-- 3. KẾT NỐI VỚI MODULE COMMON -->
        <!-- Để server dùng được Request/Response/Model từ common -->
        <dependency>
            <groupId>com.tboat</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 4. MySQL Connector (Riêng server cần cái này) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- Gson không cần khai báo ở đây vì đã được kế thừa từ Parent -->
    </dependencies>
</project>