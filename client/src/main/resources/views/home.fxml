<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.HomeController">
    <children>

        <fx:include source="header.fxml" />

        <VBox VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0" maxWidth="Infinity">
                    <children>
                        <Label text="Đấu Giá Trực Tuyến" textFill="#0A1128">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" style="-fx-background-color: #EFEFEF; -fx-background-radius: 20; -fx-padding: 4;">
                            <children>
                                <Button fx:id="btnFilterAll" onAction="#filterAll" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 8 20; -fx-cursor: hand;" text="Tất cả" />
                                <Button fx:id="btnFilterDienTu" onAction="#filterDienTu" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="Điện tử" />
                                <Button fx:id="btnFilterThoiTrang" onAction="#filterThoiTrang" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="Thời trang" />
                                <Button fx:id="btnFilterTrangSuc" onAction="#filterTrangSuc" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="Trang sức" />
                                <Button fx:id="btnFilterKhac" onAction="#filterKhac" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand;" text="Khác" />
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin><Insets bottom="30.0" /></VBox.margin>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                    <content>
                        <FlowPane fx:id="itemContainer" hgap="35.0" vgap="35.0" maxWidth="Infinity">
                            <padding><Insets bottom="20.0" left="10.0" right="10.0" top="10.0" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</VBox>