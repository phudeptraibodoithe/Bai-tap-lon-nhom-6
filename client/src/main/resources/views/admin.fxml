<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="500.0" minWidth="800.0" prefHeight="700.0" prefWidth="1000.0" styleClass="admin-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.AdminController">

    <stylesheets>
        <URL value="@../styles/application.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" styleClass="admin-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="59.0" fitWidth="129.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <HBox alignment="CENTER_LEFT" minWidth="-Infinity" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="btn-admin-nav" text="HỆ THỐNG QUẢN TRỊ" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#switchToAdminNapRut" styleClass="btn-admin-nav" text="QUẢN LÝ SỐ DƯ" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" minWidth="-Infinity" spacing="15.0">
                    <children>
                        <Label text="Xin chào, Admin!" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#logout" styleClass="btn-logout" text="Đăng xuất" textFill="WHITE">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <VBox maxHeight="Infinity" maxWidth="Infinity" spacing="15.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <Label text="Quản Lý Phiên Đấu Giá">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>

                <Label fx:id="err" textFill="#3498db">
                    <font><Font name="System Italic" size="14.0" /></font>
                </Label>

                <TableView fx:id="tableSessions" prefHeight="450.0" styleClass="table-shadow" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" minWidth="50.0" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colName" minWidth="150.0" prefWidth="250.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="colStartPrice" minWidth="100.0" prefWidth="120.0" text="Giá Khởi Điểm" />
                        <TableColumn fx:id="colJump" minWidth="100.0" prefWidth="120.0" text="Bước nhảy" />
                        <TableColumn fx:id="colSeller" minWidth="100.0" prefWidth="120.0" text="Seller" />
                        <TableColumn fx:id="colStatus" minWidth="110.0" prefWidth="130.0" text="Trạng thái" />
                        <TableColumn fx:id="colApprove" minWidth="80.0" prefWidth="80.0" styleClass="col-center" text="Xác nhận" />
                        <TableColumn fx:id="colReject" minWidth="80.0" prefWidth="80.0" styleClass="col-center" text="Từ chối" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>
