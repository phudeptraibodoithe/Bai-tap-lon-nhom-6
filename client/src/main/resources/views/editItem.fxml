<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="750.0" prefWidth="1100.0" styleClass="form-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.ControllerEditItem">

    <stylesheets>
        <URL value="@../styles/application.css" />
    </stylesheets>

    <children>
        <fx:include source="header.fxml" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <content>
                <VBox VBox.vgrow="ALWAYS" maxWidth="Infinity">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #0A1128;" text="Sửa Thông Tin Sản Phẩm">
                            <font><Font name="System Bold" size="32.0" /></font>
                            <VBox.margin><Insets bottom="30.0" /></VBox.margin>
                        </Label>

                        <HBox spacing="40.0" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                            <children>

                                <VBox prefWidth="400.0" minWidth="350.0" maxWidth="450.0" spacing="25.0" styleClass="form-card" style="-fx-padding: 25;">
                                    <children>
                                        <Label style="-fx-text-fill: #0A1128;" text="Hình ảnh sản phẩm">
                                            <font><Font name="System Bold" size="18.0" /></font>
                                        </Label>

                                        <StackPane fx:id="imageFrame" prefHeight="260.0" styleClass="image-upload-frame">
                                            <children>
                                                <VBox alignment="CENTER" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #9DA3B4;" text="📷"><font><Font size="40.0" /></font></Label>
                                                        <Label style="-fx-text-fill: #666666;" text="Nhấn để đổi ảnh"><font><Font name="System Bold" size="14.0" /></font></Label>
                                                    </children>
                                                </VBox>
                                                <ImageView fx:id="myImageView" fitHeight="250.0" fitWidth="340.0" onMouseClicked="#uploadImage" pickOnBounds="true" preserveRatio="true" />
                                            </children>
                                        </StackPane>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Thời gian bắt đầu">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <DatePicker fx:id="datePickerStart" maxWidth="Infinity" prefHeight="40.0" promptText="Chọn ngày..." styleClass="input-field" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Spinner fx:id="hourStart" prefHeight="35.0" prefWidth="125.0" style="-fx-background-radius: 8;" />
                                                        <Label text=":" />
                                                        <Spinner fx:id="minuteStart" prefHeight="35.0" prefWidth="125.0" style="-fx-background-radius: 8;" />
                                                        <Label style="-fx-text-fill: #666666;" text="(Giờ : Phút)"><font><Font size="12.0" /></font></Label>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Thời gian kết thúc">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <DatePicker fx:id="datePickerEnd" maxWidth="Infinity" prefHeight="40.0" promptText="Chọn ngày..." styleClass="input-field" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Spinner fx:id="hourEnd" prefHeight="35.0" prefWidth="125.0" style="-fx-background-radius: 8;" />
                                                        <Label text=":" />
                                                        <Spinner fx:id="minuteEnd" prefHeight="35.0" prefWidth="125.0" style="-fx-background-radius: 8;" />
                                                        <Label style="-fx-text-fill: #666666;" text="(Giờ : Phút)"><font><Font size="12.0" /></font></Label>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="20.0" styleClass="form-card" style="-fx-padding: 30;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <children>
                                        <Label style="-fx-text-fill: #0A1128;" text="Thông tin cơ bản">
                                            <font><Font name="System Bold" size="18.0" /></font>
                                            <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                                        </Label>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Tên sản phẩm">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <TextField fx:id="nameItem" prefHeight="45.0" promptText="Nhập tên sản phẩm..." styleClass="input-field" maxWidth="Infinity" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Loại sản phẩm">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <ComboBox fx:id="typeComboBox" maxWidth="Infinity" prefHeight="45.0" promptText="Chọn loại sản phẩm..." styleClass="input-field" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Mô tả chi tiết">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <TextArea fx:id="inforItem" prefHeight="233.0" promptText="Thông tin sản phẩm, tình trạng..." styleClass="input-field-textarea" wrapText="true" VBox.vgrow="ALWAYS" maxWidth="Infinity" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="20.0" maxWidth="Infinity">
                                            <children>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-text-fill: #0A1128;" text="Giá khởi điểm (VNĐ)">
                                                            <font><Font name="System Bold" size="13.0" /></font>
                                                        </Label>
                                                        <Spinner fx:id="priceSpinner" editable="true" maxWidth="Infinity" prefHeight="40.0" styleClass="input-field" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-text-fill: #0A1128;" text="Bước nhảy (VNĐ)">
                                                            <font><Font name="System Bold" size="13.0" /></font>
                                                        </Label>
                                                        <Spinner fx:id="jumpSpinner" editable="true" maxWidth="Infinity" prefHeight="40.0" styleClass="input-field" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0A1128;" text="Giá bán ngay (VNĐ)">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Spinner fx:id="buyNowSpinner" editable="true" maxWidth="Infinity" prefHeight="40.0" styleClass="input-field" />
                                            </children>
                                        </VBox>

                                        <Region VBox.vgrow="ALWAYS" />

                                        <HBox alignment="CENTER_RIGHT" spacing="15.0" maxWidth="Infinity">
                                            <children>
                                                <Label fx:id="thongbao" style="-fx-text-fill: #E63946;" wrapText="true" HBox.hgrow="ALWAYS">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />

                                                <Button fx:id="btnDeleteItem" mnemonicParsing="false" onAction="#deleteItem" prefHeight="45.0" prefWidth="150.0" styleClass="btn-danger" text="XÓA SẢN PHẨM" />
                                                <Button fx:id="btnCancelEdit" mnemonicParsing="false" onAction="#cancelEdit" prefHeight="45.0" prefWidth="130.0" styleClass="btn-secondary" text="HỦY THAY ĐỔI" />
                                                <Button fx:id="btnSaveItem" mnemonicParsing="false" onAction="#saveItem" prefHeight="45.0" prefWidth="150.0" styleClass="btn-primary" text="LƯU THAY ĐỔI" />
                                            </children>
                                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
