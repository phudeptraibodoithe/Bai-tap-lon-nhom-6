<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.TrangChuController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <ImageView fitHeight="77.0" fitWidth="103.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
                <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: #F0F4FF; -fx-padding: 8 18; -fx-background-radius: 8; -fx-cursor: hand;" text="Trang chủ" textFill="#0A1128">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#switchToHistory" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Lịch sử" textFill="#0A1128">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToManager" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Quản lý sản phẩm">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button fx:id="btnPostItem" mnemonicParsing="false" onAction="#switchToPostItem" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Đăng sản phẩm" textFill="#0A1128">
                    <font><Font size="14.0" /></font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" minWidth="-Infinity" spacing="15.0">
                    <children>
                        <Label fx:id="lblGreeting" minWidth="-Infinity" text="Hello username" textFill="#0A1128">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>

                        <Button mnemonicParsing="false" onAction="#switchToProfile" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                            <graphic>
                                <ImageView fx:id="userAvatar" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="false" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <VBox VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                    <children>
                        <Label text="Live Auctions" textFill="#0A1128">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" style="-fx-background-color: #EFEFEF; -fx-background-radius: 20; -fx-padding: 4;">
                            <children>
                                <Button fx:id="btnFilterAll" mnemonicParsing="false" onAction="#filterAll" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 8 20; -fx-cursor: hand; -fx-text-fill: #0A1128;" text="Tất cả">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button fx:id="btnFilterDienTu" mnemonicParsing="false" onAction="#filterDienTu" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand; -fx-text-fill: #666666;" text="Điện tử">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button fx:id="btnFilterThoiTrang" mnemonicParsing="false" onAction="#filterThoiTrang" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand; -fx-text-fill: #666666;" text="Thời trang">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button fx:id="btnFilterTrangSuc" mnemonicParsing="false" onAction="#filterTrangSuc" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand; -fx-text-fill: #666666;" text="Trang sức">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                                <Button fx:id="btnFilterKhac" mnemonicParsing="false" onAction="#filterKhac" style="-fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand; -fx-text-fill: #666666;" text="Khác">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="itemContainer" hgap="35.0" vgap="35.0">
                            <padding>
                                <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                            </children>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</VBox>