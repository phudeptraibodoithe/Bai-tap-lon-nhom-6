<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="750.0" prefWidth="1100.0" styleClass="manager-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.ManagerController">

    <stylesheets>
        <URL value="@../styles/application.css" />
    </stylesheets>

    <children>
        <fx:include source="header.fxml" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <content>
                <VBox spacing="25.0" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <Label style="-fx-text-fill: #0A1128;" text="Quản Lý Sản Phẩm Của Tôi">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>

                        <TableView fx:id="tableMyItems" prefHeight="500.0" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Mã SP" />
                                <TableColumn fx:id="colName" prefWidth="300.0" text="Tên Sản Phẩm" />
                                <TableColumn fx:id="colType" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Loại" />
                                <TableColumn fx:id="colPrice" prefWidth="180.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Hiện Tại (VNĐ)" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                                <TableColumn fx:id="colAction" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Thao Tác" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>