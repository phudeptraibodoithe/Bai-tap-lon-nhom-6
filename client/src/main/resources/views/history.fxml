<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="750.0" prefWidth="1100.0" styleClass="history-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tboat.controllers.ControllerHistory">

    <stylesheets>
        <URL value="@../styles/application.css" />
    </stylesheets>

    <children>
        <fx:include source="header.fxml" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <content>
                <VBox VBox.vgrow="ALWAYS" maxWidth="Infinity">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #0A1128;" text="Lịch Sử Hoạt Động">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="30.0" />
                            </VBox.margin>
                        </Label>

                        <VBox fx:id="lichsu" spacing="20.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" maxWidth="Infinity" />

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>